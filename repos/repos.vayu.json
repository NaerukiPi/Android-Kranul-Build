[
  {
    "kernelSource": {
      "name": "coral_kernel",
      "repo": "https://github.com/NaerukiPi/android_kernel_xiaomi_sm8150",
      "branch": "coral-12.1",
      "device": "vayu",
      "defconfig": "vayu_user_defconfig"
    },
    "kernelSU": {
      "withKernelSU": true,
      "kernelSUFork": "KernelSU",
      "customUrl": "https://raw.githubusercontent.com/backslashxx/KernelSU/master/kernel/setup.sh"
    },
    "ccache": true,
    "toolchains": [
      {
        "name": "clang",
        "url": "https://github.com/XSans0/WeebX-Clang/releases/download/WeebX-Clang-19.1.5-release/WeebX-Clang-19.1.5.tar.gz",
        "binPath": ["bin"]
      }
    ],
    "params": {
       "ARCH": "arm64",
       "CC": "clang",
    "externalCommand": {
  "CLANG_TRIPLE": "aarch64-linux-gnu-",
  "CROSS_COMPILE": "aarch64-linux-gnu-",
  "CROSS_COMPILE_COMPAT": "arm-linux-gnueabi-",
  "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
  "LD": "ld.lld",
  "AR": "llvm-ar",
  "NM": "llvm-nm",
  "OBJCOPY": "llvm-objcopy",
  "OBJDUMP": "llvm-objdump",
  "READELF": "llvm-readelf",
  "OBJSIZE": "llvm-size",
  "STRIP": "llvm-strip"
    }
 },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/NaerukiPi/AnyKernel3",
      "branch": "master"
    }
  }
]
